<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nom" FontSize="16" />
            <Entry Text="{Binding Nom, Mode=TwoWay}"
                   Placeholder="Votre nom" />
            <Label Text="Date de naissance" FontSize="16" />
            <DatePicker Date="{Binding DateNaissance}" />
            <Label Text="La date de naissance ne peut pas etre dans le futur"
                   TextColor="Red"
                   IsVisible="{Binding DateFuture}" />
            <Button Text="Calculer"
                    Command="{Binding CalculerCommand}" />
            <Button Text="Effacer"
                    Command="{Binding EffacerCommand}" />
            <Label Text="{Binding Resultat}" FontSize="20"
                   IsVisible="{Binding ResultatVisible}" />
            <Label Text="{Binding Statut}" FontSize="18"
                   FontAttributes="Bold"
                   IsVisible="{Binding ResultatVisible}" />
            <Label Text="{Binding ProchainAnniversaire}" FontSize="16"
                   IsVisible="{Binding ResultatVisible}" />

            <Label Text="Historique" FontSize="18"
                   FontAttributes="Bold" Margin="0,20,0,0" />
            <CollectionView ItemsSource="{Binding Historique}">
                <CollectionView.EmptyView>
                    <Label Text="Aucun calcul pour le moment" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" Padding="0,4" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Vider l'historique"
                    Command="{Binding ViderHistoriqueCommand}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
